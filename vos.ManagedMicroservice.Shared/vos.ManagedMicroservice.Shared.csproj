<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NJsonSchema" Version="11.0.2" />
    <!-- One JSONata engine wiring shared by Tributary (endpoint transforms) and Phloem (on-wire transforms, #5875). -->
    <PackageReference Include="Jsonata.Net.Native.SystemTextJson" Version="2.11.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Contracts\Schemas\*.json" />
  </ItemGroup>

</Project>
