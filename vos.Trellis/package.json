    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.8",
    "i18next": "^25.10.10",
    "lucide-react": "^0.563.0",
    "maplibre-gl": "^6.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^7.13.0",
