<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- One exact engine version: the text a page is worded in is whatever this version's locale data
       produces, and the wording test holds that text. A floating version would change it unseen. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ClearScript.V8" Version="[7.5.1.1]" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.osx-arm64" Version="[7.5.1.1]" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-x64" Version="[7.5.1.1]" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="reader.bundle.js" LogicalName="vos.Pages.reader.bundle.js" />
  </ItemGroup>

</Project>
