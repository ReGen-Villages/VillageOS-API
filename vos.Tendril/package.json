{
  "name": "@tendril-ui/tendril",
  "version": "0.12.0",
  "description": "The console's binding reader and the widgets that write, for any application that draws a model's pages",
  "license": "(AGPL-3.0-only OR LicenseRef-Commercial)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./reader": "./src/reader.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/setupTests.ts"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.reader.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "i18next": "^25.10.10",
    "react": "^19.2.0",
    "react-i18next": "^16.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "i18next": "^25.10.10",
    "jsdom": "^28.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.6.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}
