<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Source-file exclusions. coverlet's XPlat data collector expects a single
               comma-separated string here, NOT nested <File> elements.

               A service entry point is excluded once it holds nothing but wiring — the decisions it
               used to make live in vos.Service.Shared (HandleRequestRouter, ServiceHost) and are
               covered there, or the endpoints are driven end to end through WebApplicationFactory.

               Xylem and Phloem are deliberately absent: their entry points still hold request
               handling of their own with no tests behind it. Excluding them would hide that rather
               than close it, so they stay counted until the handling is extracted and covered.

               ServiceEntryPointsAreDecidedTests holds the other half of this: a service whose entry
               point is neither excluded here nor named there fails the build, so a new one cannot
               land counted-and-unexplained the way LandAllocation and FoodBalance did. -->
          <ExcludeByFile>**/vos.Service.CSharp.Echo/Program.cs,**/vos.Service.Delta/Program.cs,**/vos.Service.Tributary/Program.cs,**/vos.Service.Metabolism/Program.cs,**/vos.Service.EnergyBalance/Program.cs,**/vos.Service.WaterReserve/Program.cs,**/vos.Service.ModelBridge/Program.cs,**/vos.Service.LandAllocation/Program.cs,**/vos.Service.FoodBalance/Program.cs,**/Tests/vos.Tests.Shared/**/*.cs</ExcludeByFile>
          <ExcludeByAttribute>
            <!-- Auto-generated / compiler synthesised code. -->
            <Attribute>System.CodeDom.Compiler.GeneratedCodeAttribute</Attribute>
            <Attribute>System.Runtime.CompilerServices.CompilerGeneratedAttribute</Attribute>
            <!-- Allow targeted opt-outs at the type/method level. -->
            <Attribute>System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute</Attribute>
          </ExcludeByAttribute>
          <Exclude>
            <!-- Test assemblies themselves. -->
            <ModulePath>.*Tests\.dll$</ModulePath>
            <ModulePath>.*vos\.Tests\.Shared\.dll$</ModulePath>
          </Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
